<?xml version="1.0" encoding="utf-8"?>
<!-- Curio launcher icon background: the "X theme" near-black. A whisper of a
     diagonal gradient keeps it from looking dead-flat under launcher shadows. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="20" android:startY="6"
                android:endX="88" android:endY="102">
                <item android:offset="0.0" android:color="#FF202024" />
                <item android:offset="0.55" android:color="#FF0D0D0F" />
                <item android:offset="1.0" android:color="#FF000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
