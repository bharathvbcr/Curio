<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API < 31 (legacy; minSdk is 31 so data_extraction_rules.xml
   is the effective one, but this is kept consistent). Excludes the credential
   DataStore from cloud auto-backup; see data_extraction_rules.xml for rationale.
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="datastore/curio_tokens.preferences_pb"/>
    <exclude domain="database" path="curio_database"/>
</full-backup-content>
