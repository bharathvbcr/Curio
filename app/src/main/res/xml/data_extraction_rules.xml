<?xml version="1.0" encoding="utf-8"?><!--
   Controls Android 12+ (API 31+) cloud backup and device-to-device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   The OAuth/HF token DataStore is excluded from both: the access/refresh tokens are
   encrypted with a non-exportable AndroidKeyStore key (useless if restored elsewhere),
   and it also holds the X userId/username in cleartext. The Room research index
   (curio_database) is intentionally left backed up so users keep their library.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/curio_tokens.preferences_pb"/>
        <exclude domain="database" path="curio_database"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/curio_tokens.preferences_pb"/>
        <exclude domain="database" path="curio_database"/>
    </device-transfer>
</data-extraction-rules>
