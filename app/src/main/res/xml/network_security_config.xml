<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.x.ai</domain>
        <domain includeSubdomains="true">api.twitter.com</domain>
        <domain includeSubdomains="true">export.arxiv.org</domain>
        <domain includeSubdomains="true">api.crossref.org</domain>
        <domain includeSubdomains="true">huggingface.co</domain>
        <domain includeSubdomains="true">api.github.com</domain>
    </domain-config>
</network-security-config>
