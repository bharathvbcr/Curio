# XAI_API_KEY: Required for xAI Grok API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
XAI_API_KEY=MY_XAI_API_KEY

# HF_TOKEN: Optional Hugging Face read token used to download the on-device
# EmbeddingGemma weights (the litert-community/embeddinggemma-300m repo is gated
# under the Gemma license). Set this to enable one-tap in-app download; users can
# also paste a token at runtime, or side-load the model files manually.
#
# NOTE: HF_TOKEN is injected by build.gradle.kts (buildConfigField), which reads it
# from local.properties or .env with a safe empty default — so it is intentionally
# NOT listed as a secrets-plugin key here. An empty `HF_TOKEN=` line would make the
# secrets plugin emit an invalid (unquoted) BuildConfig field and break the build.
# To bake one in, add `HF_TOKEN=hf_xxx` to local.properties instead.
